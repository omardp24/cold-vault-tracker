# Copia este archivo a .env.local y coloca tus propias claves.
# Estas llamadas se hacen desde el servidor (rutas /api de Next.js), nunca desde el navegador,
# así que las claves nunca quedan expuestas al público.

# Supabase — donde vive TODO el estado de la app (wallets, aliados, planes, usuarios, comprobantes).
# Dashboard de Supabase → Project Settings → API.
# OJO: es la "service_role" key, NO la "anon" key — tiene privilegios completos, nunca la expongas
# en código de cliente ni la subas a un repo público.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ETHPLORER_KEY=freekey
TRONGRID_KEY=

# Opcional: activa la verificación de fraude/spam/lista negra de Tronscan en la pestaña Auditoría.
# Sin esto, la auditoría en TRON igual revisa sanciones OFAC + lista negra pública de stablecoins.
# Key gratuita en https://tronscan.org (sección API Keys de tu perfil).
TRONSCAN_KEY=

# Protege /api/cron/daily-sync (snapshot diario, notificaciones, reporte mensual).
# Generalo una vez con `openssl rand -hex 24` y ponelo también en Vercel → Settings →
# Environment Variables — Vercel Cron lo manda solo como header Authorization si está seteado ahí.
CRON_SECRET=

# Notificaciones push (Web Push / VAPID). Generalas una sola vez con:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY no es secreta — también va en NEXT_PUBLIC_VAPID_PUBLIC_KEY (mismo valor)
# para que el navegador pueda suscribirse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Envío de correo (reportes mensuales) vía Gmail SMTP con tu propia cuenta.
# App Password (no tu contraseña normal) en myaccount.google.com/apppasswords
# — requiere verificación en 2 pasos activada en esa cuenta.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Sugerencia de clasificación con IA (Gemini). Key gratuita en aistudio.google.com/apikey.
# Sin esto, el botón "Sugerir" de Movimientos simplemente no aparece — no rompe nada.
GEMINI_API_KEY=
